{
  "name": "xp",
  "font": { "ui": "Tahoma.ttf" },
  "colors": {
    "textPrimary": "#000000",
    "textMuted": "#4C4C4C",
    "textDisabled": "#ACA899",
    "messageInfo": "#1A6B1A",
    "messageError": "#A50000",
    "rowActiveBorder": "#316AC5",
    "swatchSelectedBorder": "#003C74",
    "swatchHoverTint": "#FFFFFF",
    "separator": "#C6C3B6"
  },
  "metrics": {
    "panelHeaderHeight": 26, "panelPadding": 6,
    "queueRowHeight": 26, "queueFooterHeight": 24, "navigationRowHeight": 36,
    "paletteStripHeight": 132, "swatchWidth": 90, "swatchHeight": 28,
    "swatchLabelHeight": 16, "swatchGap": 6,
    "bucketRowHeight": 26, "bucketChipSize": 14,
    "metadataRowHeight": 18, "metadataStripPadding": 6,
    "buttonWidth": 94, "buttonHeight": 23,
    "bucketsFooterHeight": 116, "footerButtonHeight": 26, "footerButtonGap": 6,
    "modalHeaderHeight": 26, "modalPadding": 14, "modalRowHeight": 20,
    "progressBarHeight": 14, "scrollBarWidth": 16, "scrollStep": 44,
    "tooltipPadding": 5
  },
  "text": { "headerSize": 13, "bodySize": 13, "smallSize": 11, "monoSize": 12 },
  "parts": {
    "window":        { "kind": "solid", "fill": "#ECE9D8" },
    "panel":         { "kind": "bevel", "fill": "#ECE9D8", "bevel": "raised",
                       "bevelLight": "#FFFFFF", "bevelDark": "#808080", "bevelThickness": 1 },
    "panelHeader":   { "kind": "gradient", "fill": "#0054E3", "fillTo": "#3A93FF",
                       "direction": "vertical", "foreground": "#FFFFFF", "cornerRadius": 3 },
    "panelFooter":   { "kind": "gradient", "fill": "#F5F3E8", "fillTo": "#E3DFCC",
                       "border": "#C6C3B6", "borderEdges": "top" },
    "paletteStrip":  { "kind": "gradient", "fill": "#F5F3E8", "fillTo": "#E3DFCC",
                       "border": "#C6C3B6", "borderEdges": "top" },
    "navigationBar": { "kind": "gradient", "fill": "#F5F3E8", "fillTo": "#E3DFCC" },
    "metadataStrip": { "kind": "solid", "fill": "#ECE9D8", "border": "#C6C3B6", "borderEdges": "top" },
    "viewport":      { "kind": "bevel", "fill": "#FFFFFF", "bevel": "sunken",
                       "bevelLight": "#FFFFFF", "bevelDark": "#404040", "bevelThickness": 1 },
    "reportList":    { "kind": "bevel", "fill": "#FFFFFF", "bevel": "sunken",
                       "bevelLight": "#FFFFFF", "bevelDark": "#404040", "bevelThickness": 1 },

    "queueRow":        { "kind": "solid", "fill": "#00000000" },
    "queueRow.hover":  { "kind": "solid", "fill": "#D8E4F8" },
    "queueRow.active": { "kind": "solid", "fill": "#316AC5", "foreground": "#FFFFFF" },
    "bucketRow":       { "kind": "solid", "fill": "#00000000" },
    "bucketRow.hover": { "kind": "solid", "fill": "#D8E4F8" },

    "button":          { "kind": "gradient", "fill": "#F5F4EA", "fillTo": "#DAD5C4",
                         "border": "#003C74", "cornerRadius": 3, "foreground": "#000000" },
    "button.hover":    { "kind": "gradient", "fill": "#FFFDE8", "fillTo": "#FFE79E", "border": "#E5A100" },
    "button.disabled": { "kind": "gradient", "fill": "#F1EFE2", "fillTo": "#E3E0D1",
                         "border": "#C6C3B6", "foreground": "#ACA899" },

    "swatch":        { "kind": "solid", "border": "#8E8B77", "borderThickness": 1, "cornerRadius": 2 },
    "swatch.active": { "kind": "solid", "border": "#003C74", "borderThickness": 2 },
    "bucketChip":    { "kind": "solid", "border": "#8E8B77", "cornerRadius": 2 },
    "bucketMarker":  { "kind": "solid", "shape": "circle" },

    "modal":         { "kind": "solid", "fill": "#ECE9D8", "border": "#0054E3", "borderThickness": 2 },
    "modalHeader":   { "kind": "gradient", "fill": "#0054E3", "fillTo": "#3A93FF",
                       "direction": "vertical", "foreground": "#FFFFFF" },
    "scrim":         { "kind": "solid", "fill": "#00000040" },
    "scrollThumb":   { "kind": "gradient", "fill": "#F5F3E8", "fillTo": "#C9C5B0",
                       "direction": "horizontal", "border": "#8E8B77", "cornerRadius": 2 },
    "scrollTrack":   { "kind": "solid", "fill": "#F1EFE2" },
    "progressTrack": { "kind": "bevel", "fill": "#FFFFFF", "bevel": "sunken",
                       "bevelLight": "#FFFFFF", "bevelDark": "#808080", "bevelThickness": 1 },
    "progressFill":  { "kind": "gradient", "fill": "#8CD08C", "fillTo": "#3FA13F" },
    "tooltip":       { "kind": "solid", "fill": "#FFFFE1", "border": "#000000" }
  }
}
